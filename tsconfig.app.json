{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* === базовые параметры === */
    "target": "ES2020",
    "module": "CommonJS",
    /* === генерация === */
    "declaration": true,
    "emitDeclarationOnly": false,
    /* === структура === */
    "rootDir": "src",
    "outDir": "../../dist/libs/utils",
    "tsBuildInfoFile": "../../dist/libs/utils.tsbuildinfo",
    /* === строгость и совместимость === */
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    /* === проектная сборка === */
    "composite": true,
    /* === алиасы для локальных пакетов === */
    "baseUrl": "../../",
    "paths": {
      "@barfinex/types": [
        "libs/types/src"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ],
}